 import org.junit.jupiter.api.DisplayName;
 import org.junit.jupiter.api.Test;
 import org.junit.jupiter.api.extension.ExtendWith;
@@ -19,6 +22,9 @@ class UnitServiceTest {
     @Mock
     private UnitRepository unitRepository;
 
+    @Mock
+    private ItemRepository itemRepository;
+
     @InjectMocks
     private UnitService unitService;
 
@@ -42,4 +48,28 @@ class UnitServiceTest {
 
         assertThat(unitService.listUnits()).isEmpty();
     }
+
+    @Test
+    @DisplayName("listActiveItemsByUnitAndLevel: 그 난이도 문항만, 저장소 순서 유지")
+    void listActiveItemsFiltersByLevel() {
+        Unit unit = ItemFixtures.unit(1, "M5-1", "분수의 덧셈과 뺄셈", 5);
+        when(unitRepository.findByCode("M5-1")).thenReturn(Optional.of(unit));
+        when(itemRepository.findByUnitCodeAndStatus("M5-1", ItemStatus.ACTIVE)).thenReturn(List.of(
+            ItemFixtures.item(3, unit, "통분 심화", 4, ItemStatus.ACTIVE),
+            ItemFixtures.item(1, unit, "분모가 같은 덧셈", 2, ItemStatus.ACTIVE),
+            ItemFixtures.item(2, unit, "분모가 같은 뺄셈", 2, ItemStatus.ACTIVE)));
+
+        assertThat(unitService.listActiveItemsByUnitAndLevel("M5-1", 2))
+            .extracting(ItemResponse::id).containsExactly(1, 2);
+        assertThat(unitService.listActiveItemsByUnitAndLevel("M5-1", 5)).isEmpty();
+    }
+
+    @Test
+    @DisplayName("listActiveItemsByUnitAndLevel: 없는 단원 코드는 NotFoundException")
+    void listActiveItemsThrowsWhenUnitMissing() {
+        when(unitRepository.findByCode("X9-9")).thenReturn(Optional.empty());
+
+        assertThatThrownBy(() -> unitService.listActiveItemsByUnitAndLevel("X9-9", 3))
+            .isInstanceOf(NotFoundException.class);
+    }
 }
