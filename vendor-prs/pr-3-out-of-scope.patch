     static String sign(String payload) {
         MessageDigest digest = sha256();
diff --git a/modern/api/src/main/java/com/example/item/UnitController.java b/modern/api/src/main/java/com/example/item/UnitController.java
index 3b99ec8..86053ed 100644
--- a/modern/api/src/main/java/com/example/item/UnitController.java
+++ b/modern/api/src/main/java/com/example/item/UnitController.java
@@ -2,7 +2,9 @@ package com.example.item;
 
 import java.util.List;
 import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
 import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
 import org.springframework.web.bind.annotation.RestController;
 
 /** 단원 API. 컨트롤러는 서비스만 호출한다. */
@@ -21,4 +23,13 @@ public class UnitController {
     public List<UnitResponse> listUnits() {
         return unitService.listUnits();
     }
+
+    /**
+     * {@code GET /api/units/{code}/items?level=3} — 단원의 공개 문항을 난이도로 거른다.
+     * {@code level} 이 없는 요청은 기존 {@code ItemController#listItemsByUnit} 이 그대로 받는다.
+     */
+    @GetMapping(value = "/{code}/items", params = "level")
+    public List<ItemResponse> listItemsByLevel(@PathVariable String code, @RequestParam int level) {
+        return unitService.listActiveItemsByUnitAndLevel(code, level);
+    }
 }
diff --git a/modern/api/src/main/java/com/example/item/UnitService.java b/modern/api/src/main/java/com/example/item/UnitService.java
index 2a60112..aede4ee 100644
--- a/modern/api/src/main/java/com/example/item/UnitService.java
+++ b/modern/api/src/main/java/com/example/item/UnitService.java
@@ -1,5 +1,6 @@
 package com.example.item;
 
+import com.example.common.NotFoundException;
 import java.util.List;
 import org.slf4j.Logger;
 import org.slf4j.LoggerFactory;
@@ -13,9 +14,11 @@ public class UnitService {
     private static final Logger log = LoggerFactory.getLogger(UnitService.class);
 
     private final UnitRepository unitRepository;
+    private final ItemRepository itemRepository;
 
-    public UnitService(UnitRepository unitRepository) {
+    public UnitService(UnitRepository unitRepository, ItemRepository itemRepository) {
         this.unitRepository = unitRepository;
+        this.itemRepository = itemRepository;
     }
 
     /** 단원 목록 — 학년, 코드 순. */
@@ -26,4 +29,22 @@ public class UnitService {
         log.debug("listed {} units", units.size());
         return units;
     }
+
+    /**
+     * 단원의 공개 문항 중 난이도가 {@code level}(1~5)인 것만.
+     * 정렬은 저장소 순서(난이도 내림차순, id 오름차순)를 그대로 따른다.
+     *
+     * @throws NotFoundException 단원 코드가 없을 때
+     */
+    public List<ItemResponse> listActiveItemsByUnitAndLevel(String unitCode, int level) {
+        if (unitRepository.findByCode(unitCode).isEmpty()) {
+            throw new NotFoundException("단원이 없습니다: code=" + unitCode);
+        }
+        List<ItemResponse> items = itemRepository.findByUnitCodeAndStatus(unitCode, ItemStatus.ACTIVE).stream()
+            .filter(item -> item.getLevel() == level)
+            .map(ItemResponse::from)
+            .toList();
+        log.debug("listed {} active items for unit {} (level={})", items.size(), unitCode, level);
+        return items;
+    }
 }
diff --git a/modern/api/src/test/java/com/example/item/UnitServiceTest.java b/modern/api/src/test/java/com/example/item/UnitServiceTest.java
